      {"file": "models/user_model.py", "start": 71, "end": 78},
      {"file": "config.py", "start": 13, "end": 13}
    ],
    "expected_fix_type": "mixed",
    "expected_patch_contains": ["resp['sub']", "filter_by", "os.environ"],
    "expected_patch_excludes": ["SELECT * FROM users WHERE username = '", "'random'"],
    "pass_criteria": [
      "Research identifies api_views/users.py, models/user_model.py, and config.py",
      "IDOR fix resolves user from JWT subject",
      "SQL injection fixed via ORM/parameterized query",
      "Hardcoded JWT secret removed from config.py"

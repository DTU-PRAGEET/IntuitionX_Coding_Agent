      "status": "In Progress",
      "priority_raw": "Critical",
      "priority_normalized": "P0",
      "module": "users",
      "labels": ["security", "idor", "sqli", "jwt", "integration", "vampi"],
      "repo_links": ["https://github.com/erev0s/VAmPI"],
      "acceptance_criteria": [
        "Password updates only affect the JWT subject account",
        "Username lookups use ORM/parameterized query, not f-string SQL",
        "JWT secret loaded from environment, not hardcoded"
      ],
      "vulnerability_category": "Mixed"
    },
    "expected_route": "FULL",
    "expected_files": ["api_views/users.py", "models/user_model.py", "config.py"],
    "expected_line_ranges": [

    "ticket": {
      "title": "Security audit bundle — SQL injection, password hashing, and stored XSS in DVPWA",
      "problem_statement": "A consolidated security review of the Testing-Security-demo (DVPWA) codebase flagged three independent findings that must all be remediated in this ticket:\n\n1. **SQL injection (student creation):** The 'Add new student' feature in sqli/dao/student.py places user-supplied names directly into an INSERT via string formatting instead of bound parameters.\n\n2. **Weak password storage:** User passwords in sqli/dao/user.py are verified against fast, unsalted MD5 hashes. Replace with a modern salted adaptive hash (bcrypt/argon2/PBKDF2).\n\n3. **Stored XSS in course reviews:** Review text is rendered without HTML escaping because autoescape is disabled application-wide (sqli/app.py) and review content is emitted unescaped in course.jinja2.\n\nAll three issues are in the same repository and must be fixed together.",
      "issue_type": "Security",
      "status": "In Progress",
      "priority_raw": "Critical",
      "priority_normalized": "P0",
      "module": "sqli",
      "labels": ["security", "sqli", "xss", "crypto", "integration", "dvpwa"],
      "repo_links": ["https://github.com/DTU-PRAGEET/Testing-Security-demo"],
      "acceptance_criteria": [
        "Student names are bound as parameters, not concatenated into SQL",
        "Passwords use a salted adaptive KDF instead of MD5",
        "Review HTML is escaped by default (autoescape enabled)"
      ],
      "vulnerability_category": "Mixed"
    },
    "expected_route": "FULL",
    "expected_files": [
      "sqli/dao/student.py",
      "sqli/dao/user.py",
      "sqli/app.py",
      "sqli/templates/course.jinja2"
    ],
    "expected_line_ranges": [
      {"file": "sqli/dao/student.py", "start": 42, "end": 45},
      {"file": "sqli/dao/user.py", "start": 40, "end": 41},
      {"file": "sqli/app.py", "start": 33, "end": 35},
      {"file": "sqli/templates/course.jinja2", "start": 20, "end": 28}
    ],
    "expected_fix_type": "mixed",
    "expected_patch_contains": ["VALUES (%(name)s)"],
    "expected_patch_excludes": ["VALUES ('%(name)s')", "md5(", "autoescape=False"],
    "pass_criteria": [
      "Research identifies all four affected files across the three findings",
      "SQL injection fixed with parameterized INSERT",
      "MD5 replaced with salted adaptive password hashing",
      "Output escaping enabled; autoescape=False removed"
    ],
